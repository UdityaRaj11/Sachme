# TruthFirewall Environment Variables Configuration

# Server Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-with-a-random-secret

# AI Provider Configuration
# Options: 'gemini', 'openai', or 'heuristic' (fallback without API keys)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Settings (optional if using openai provider)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Search & Evidence Retrieval
# Options: 'duckduckgo', 'tavily', or 'serpapi'
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your-tavily-api-key-here
SERPAPI_API_KEY=your-serpapi-key-here

# Performance & Security
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=3600
